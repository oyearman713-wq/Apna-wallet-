# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Payment Provider & UPI TPAP Configuration (defaults to sandbox if unset)
UPI_PROVIDER_MODE=sandbox
PSP_PROVIDER=razorpay_sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NPCI_TPAP_LICENSE_ID=

# SMS OTP Provider Configuration (defaults to sandbox if unset)
SMS_PROVIDER=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
